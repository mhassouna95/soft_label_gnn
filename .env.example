# Copy this file to .env and fill in your own values. Never commit .env.

# Bearer token InteractiveAI must send with every request.
# Generate one with: openssl rand -hex 32
API_TOKEN=change-me

# Host port the API is published on by docker compose (the container listens on 8000).
AGENT_PORT=5124

# Optional overrides, defaults shown.
# N_RECOMMENDATIONS=3
# EXTRA_SIMULATION_BUDGET=300
# BEST_ACTION_THRESHOLD=0.95
# MAX_ACTION_SIM=2000
# AGENT_TYPE=2
